# =============================================================================
# Supabase Edge Functions secrets — AI Business Concierge
# Yangilandi: 2026-04-29 (Phase 0 yakunlash)
# =============================================================================
# Bu .env.example faqat ma'lumot uchun. Lokal `supabase functions serve`
# uchun .env nomida nusxa oling. Production da qiymatlarni Supabase secrets
# orqali sozlang:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-... --project-ref <ref>
#   supabase secrets set TELEGRAM_BOT_TOKEN=...        --project-ref <ref>
#
# Hech qachon real qiymatlarni .env ga yozib commit qilmang!
# =============================================================================

# ----- Supabase ichki (avtomatik to'ldiriladi) ------------------------------
# Bu o'zgaruvchilar Supabase tomonidan avtomatik beriladi — `supabase secrets`
# bilan o'zgartirmang. Lokal dev uchun shu yerda yozish mumkin.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# Backend tarafdan SB_ prefix orqali ham o'qiladi (legacy fallback)
SB_URL=https://your-project-id.supabase.co
SB_SERVICE_ROLE_KEY=eyJ...
SB_ANON_KEY=eyJ...

# JWT secret (Auth tokenlarni tekshirish uchun)
# Supabase Dashboard → Project Settings → API → JWT Secret
JWT_SECRET=your-jwt-secret

# ----- Anthropic Claude (Phase 0 — asosiy AI provider) ----------------------
# https://console.anthropic.com → Settings → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-api03-...
# Modellar — env orqali override qilish mumkin (services/llm-router.ts)
CLAUDE_HAIKU_MODEL=claude-3-5-haiku-20241022
CLAUDE_SONNET_MODEL=claude-sonnet-4-5

# ----- OpenAI (embedding + fallback) ----------------------------------------
# Knowledge Base embedding (text-embedding-3-small) va Claude fallback uchun
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ----- Telegram bot (Phase 1+) ----------------------------------------------
# @BotFather → /newbot → token oling
TELEGRAM_BOT_TOKEN=
# Webhook himoyasi uchun random secret (32+ belgi)
TELEGRAM_WEBHOOK_SECRET=

# ----- Click to'lov (Phase 3) -----------------------------------------------
# https://merchant.click.uz → Sozlamalar → Texnik
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# ----- Payme to'lov (Phase 3) -----------------------------------------------
# https://merchant.payme.uz
PAYME_MERCHANT_ID=
PAYME_KEY=

# ----- Resend (transactional email — Phase 1) -------------------------------
# https://resend.com → API Keys
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=

# ----- Sentry (error monitoring) --------------------------------------------
# https://sentry.io → Projects → ai-business-concierge-backend → Settings → Client Keys
SENTRY_DSN=

# ----- Boshqa ---------------------------------------------------------------
# Production environment label (development / staging / production)
APP_ENV=development
