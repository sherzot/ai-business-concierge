{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-business-concierge.uz/schemas/candidate-analysis.schema.json",
  "title": "CandidateAnalysisResult",
  "description": "MVP output of the hr_candidate_analysis module. Session-only, no persistence.",
  "type": "object",
  "required": ["request_id", "status", "duration_ms", "locale"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "error" } },
        "required": ["status"]
      },
      "then": {
        "required": ["error"],
        "not": { "required": ["result"] }
      },
      "else": {
        "required": ["result"],
        "not": { "required": ["error"] }
      }
    }
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "description": "ULID for tracing/logging.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "status": {
      "type": "string",
      "enum": ["ok", "degraded", "error"],
      "description": "ok = full result, degraded = partial signals (e.g. GitHub failed), error = top-level failure (then `error` is set)."
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "locale": {
      "type": "string",
      "enum": ["uz", "ja", "en"]
    },
    "result": {
      "$ref": "#/$defs/CandidateAnalysisPayload"
    },
    "error": {
      "$ref": "#/$defs/ErrorEnvelope"
    }
  },

  "$defs": {
    "CandidateAnalysisPayload": {
      "type": "object",
      "required": [
        "overall_score",
        "grade",
        "category_scores",
        "strengths",
        "weaknesses",
        "inconsistency_flags",
        "summary",
        "interview_questions",
        "hiring_recommendation",
        "raw_signals"
      ],
      "additionalProperties": false,
      "properties": {
        "overall_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "grade": { "type": "string", "enum": ["A+", "A", "B+", "B", "C+", "C", "D", "F"] },
        "category_scores": { "$ref": "#/$defs/CategoryScores" },
        "strengths": {
          "type": "array",
          "items": { "type": "string", "minLength": 4, "maxLength": 240 },
          "minItems": 1,
          "maxItems": 8
        },
        "weaknesses": {
          "type": "array",
          "items": { "type": "string", "minLength": 4, "maxLength": 240 },
          "maxItems": 8
        },
        "inconsistency_flags": {
          "type": "array",
          "items": { "$ref": "#/$defs/InconsistencyFlag" }
        },
        "summary": { "type": "string", "minLength": 50, "maxLength": 1500 },
        "interview_questions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/InterviewQuestion" }
        },
        "hiring_recommendation": { "$ref": "#/$defs/HiringRecommendation" },
        "raw_signals": { "$ref": "#/$defs/RawSignals" }
      }
    },

    "CategoryScores": {
      "type": "object",
      "required": [
        "tech_depth",
        "project_quality",
        "activity",
        "communication_docs",
        "cv_github_consistency",
        "role_fit"
      ],
      "additionalProperties": false,
      "properties": {
        "tech_depth": { "type": "integer", "minimum": 0, "maximum": 100 },
        "project_quality": { "type": "integer", "minimum": 0, "maximum": 100 },
        "activity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "communication_docs": { "type": "integer", "minimum": 0, "maximum": 100 },
        "cv_github_consistency": { "type": "integer", "minimum": 0, "maximum": 100 },
        "role_fit": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 100 },
            { "type": "null", "description": "null when no job_description provided" }
          ]
        }
      }
    },

    "InconsistencyFlag": {
      "type": "object",
      "required": ["type", "severity", "explanation"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "stack_mismatch",
            "experience_gap",
            "title_inflation",
            "education_unverified",
            "timeline_conflict",
            "other"
          ]
        },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] },
        "explanation": { "type": "string", "minLength": 10, "maxLength": 500 }
      }
    },

    "InterviewQuestion": {
      "type": "object",
      "required": ["category", "question", "expected_signal"],
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "tech_depth",
            "project_quality",
            "activity",
            "communication_docs",
            "consistency",
            "role_fit",
            "behavioral"
          ]
        },
        "question": { "type": "string", "minLength": 15, "maxLength": 400 },
        "expected_signal": { "type": "string", "minLength": 15, "maxLength": 400 },
        "linked_evidence": {
          "type": "string",
          "description": "Optional reference, e.g. 'pinned_repo:my-app' or 'cv_role:Senior Engineer @ Acme'"
        }
      }
    },

    "HiringRecommendation": {
      "type": "object",
      "required": ["decision", "confidence", "rationale"],
      "additionalProperties": false,
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["strong_hire", "interview", "borderline", "do_not_proceed"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 30, "maxLength": 800 }
      }
    },

    "RawSignals": {
      "type": "object",
      "required": ["github", "cv"],
      "additionalProperties": false,
      "properties": {
        "github": { "$ref": "#/$defs/GithubSignals" },
        "cv": { "$ref": "#/$defs/CvSignals" }
      }
    },

    "GithubSignals": {
      "type": "object",
      "required": ["fetch_status"],
      "additionalProperties": false,
      "properties": {
        "username": { "type": "string" },
        "profile_url": { "type": "string", "format": "uri" },
        "account_age_years": { "type": "number", "minimum": 0 },
        "followers": { "type": "integer", "minimum": 0 },
        "following": { "type": "integer", "minimum": 0 },
        "public_repos": { "type": "integer", "minimum": 0 },
        "total_stars_received": { "type": "integer", "minimum": 0 },
        "primary_languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "percent"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "percent": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        },
        "activity": {
          "type": "object",
          "required": ["commits_last_year_estimate", "active_months_last_12", "longest_streak_days"],
          "additionalProperties": false,
          "properties": {
            "commits_last_year_estimate": { "type": "integer", "minimum": 0 },
            "active_months_last_12": { "type": "integer", "minimum": 0, "maximum": 12 },
            "longest_streak_days": { "type": "integer", "minimum": 0 }
          }
        },
        "repo_signals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "with_readme_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "with_tests_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "with_ci_cd_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "fork_to_original_ratio": { "type": "number", "minimum": 0 }
          }
        },
        "pinned_repos": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/PinnedRepo" }
        },
        "fetch_status": { "type": "string", "enum": ["complete", "partial", "failed"] },
        "error_reason": { "type": "string" }
      }
    },

    "PinnedRepo": {
      "type": "object",
      "required": ["name", "stars", "primary_language", "is_fork", "quality_score"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "stars": { "type": "integer", "minimum": 0 },
        "primary_language": { "type": ["string", "null"] },
        "has_readme": { "type": "boolean" },
        "has_tests": { "type": "boolean" },
        "has_ci": { "type": "boolean" },
        "last_commit_at": { "type": ["string", "null"], "format": "date-time" },
        "is_fork": { "type": "boolean" },
        "quality_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "description": { "type": ["string", "null"] }
      }
    },

    "CvSignals": {
      "type": "object",
      "required": ["filename", "format", "extracted_text_chars", "parse_status"],
      "additionalProperties": false,
      "properties": {
        "filename": { "type": "string" },
        "format": { "type": "string", "enum": ["pdf", "docx"] },
        "extracted_text_chars": { "type": "integer", "minimum": 0 },
        "experience_years_total": { "type": "number", "minimum": 0 },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "company", "start"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "company": { "type": "string" },
              "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
              "end": {
                "oneOf": [
                  { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
                  { "type": "null", "description": "null = currently in role" }
                ]
              },
              "duration_months": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "tech_skills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["degree", "institution"],
            "additionalProperties": false,
            "properties": {
              "degree": { "type": "string" },
              "institution": { "type": "string" },
              "year": { "type": ["integer", "null"] }
            }
          }
        },
        "languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parse_status": { "type": "string", "enum": ["complete", "partial", "failed"] },
        "error_reason": { "type": "string" }
      }
    },

    "ErrorEnvelope": {
      "type": "object",
      "required": ["code", "message_uz", "message_ja", "message_en"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "INVALID_GITHUB_INPUT",
            "GITHUB_USER_NOT_FOUND",
            "GITHUB_UNAVAILABLE",
            "CV_PARSE_FAILED",
            "CV_TOO_LARGE",
            "UNSUPPORTED_FILE_TYPE",
            "UNAUTHENTICATED",
            "FORBIDDEN_ROLE",
            "RATE_LIMITED",
            "RATE_LIMIT_UNAVAILABLE",
            "AI_UNAVAILABLE",
            "NOT_IMPLEMENTED",
            "TIMEOUT",
            "INTERNAL"
          ]
        },
        "message_uz": { "type": "string" },
        "message_ja": { "type": "string" },
        "message_en": { "type": "string" },
        "field": { "type": "string" }
      }
    }
  }
}
