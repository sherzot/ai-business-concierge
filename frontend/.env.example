# =============================================================================
# Frontend .env example — AI Business Concierge
# Yangilandi: 2026-04-29 (Phase 0 yakunlash)
# =============================================================================
# Bu faylni .env nomida nusxa oling va o'z qiymatlaringizni qo'ying:
#   cp frontend/.env.example frontend/.env
# .env GIT ga qo'shilmaydi (.gitignore da). .env.example commit bo'ladi.
# =============================================================================

# ----- Supabase (majburiy) --------------------------------------------------
# Supabase Dashboard → Settings → API Keys / Connect
VITE_SUPABASE_PROJECT_ID=your-project-id
# Browser uchun faqat sb_publishable_... key ishlating. Secret/service_role emas.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# ----- Backend API base (ixtiyoriy) -----------------------------------------
# Default: Supabase Edge Function URL avtomatik yasaladi.
# Lokal dev yoki custom proxy uchun override qiling.
# VITE_API_BASE_URL=https://your-project-id.supabase.co/functions/v1/bright-api/make-server-6c2837d6/v1

# ----- App URL (ixtiyoriy) --------------------------------------------------
# Frontend kanonik URL (auth redirectlar va SEO uchun)
# VITE_APP_URL=https://app.your-domain.uz

# ----- Sentry (ixtiyoriy, error monitoring) ---------------------------------
# Sentry → Projects → ai-business-concierge-frontend → Settings → Client Keys (DSN)
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_RELEASE=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ----- Telegram bot (Phase 1+) ----------------------------------------------
# Bot username — frontend dan https://t.me/<username> link uchun
# VITE_TELEGRAM_BOT_USERNAME=ai_business_concierge_bot

# ----- Feature flags (progressive rollout) ----------------------------------
# VITE_FEATURE_HR_CANDIDATES=true
# VITE_FEATURE_SALES_BOTS=false
# VITE_FEATURE_ADMIN_PANEL=true

# ----- Locale ---------------------------------------------------------------
# Default fallback til (uz / ru / en / ja)
# VITE_DEFAULT_LOCALE=uz
